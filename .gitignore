# ==========================================
# SOC-Lite - .gitignore
# ==========================================

# --- Variables de entorno y secretos ---
# Ignora cualquier archivo .env excepto las plantillas
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12

# --- Python (ai-service y backend) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Entornos virtuales de Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Caches y herramientas de testing / linting de Python
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/
.pytype/

# --- Node.js & Frontend (React / Vite / TypeScript) ---
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Archivos temporales y datos locales ---
.cache_temp/
reports/
data/
*.log
*.tmp
*.temp
*.bak
* - copia*
* - Copy*

# Bases de datos locales
*.sqlite
*.sqlite3
*.db
postgres_data/

# --- Editores e IDEs ---
.vscode/
!.vscode/settings.json.example
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Sistema operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
